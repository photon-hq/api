```python Python
photon.projects.get_webhook_destination(input: GetWebhookDestinationInput) -> models.WebhookDestination
```
</Tab>
<Tab title="Rust">
```rust Rust
client.get_webhook_destination(destination_id: String, project_id: String).await -> Result<ResponseValue<types::WebhookDestination>, Error<GetWebhookDestinationError>>
```
</Tab>
</Tabs>

<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon({
  headers: { Authorization: `Bearer ${process.env.PHOTON_API_TOKEN}` },
});
const result = await photon.projects.getWebhookDestination({
  path: {
    destinationId: "destinationId",
    projectId: "projectId",
  },
});
```

```python Python
import os

from photon_api import Photon
from photon_api.rpc_generated import GetWebhookDestinationInput

photon = Photon(headers={"Authorization": f"Bearer {os.environ['PHOTON_API_TOKEN']}"})
result = photon.projects.get_webhook_destination(
    GetWebhookDestinationInput.model_validate({
        "path": {
            "destinationId": "destinationId",
            "projectId": "projectId",
        },
    })
)
```

```rust Rust
use photon_ai_api::{Credential, PhotonClientBuilder, SecretString};

let token = std::env::var("PHOTON_API_TOKEN")?;
let client = PhotonClientBuilder::new()
    .credential("accountServiceKey", Credential::Bearer(SecretString::from(token)))
    .build()?;
let result = client
    .get_webhook_destination("destinationId".to_owned(), "projectId".to_owned())
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

</RequestExample>

