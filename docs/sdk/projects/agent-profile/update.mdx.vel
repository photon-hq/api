</Tabs>

<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon({
  headers: { Authorization: `Bearer ${process.env.PHOTON_API_TOKEN}` },
});
const result = await photon.projects.agentProfile.update({
  path: {
    projectId: "projectId",
  },
  headers: {
    idempotencyKey: "idempotencyKey",
  },
  body: {},
});
```

```python Python
import os

from photon_api import Photon
from photon_api.rpc_generated import UpdateAgentProfileInput

photon = Photon(headers={"Authorization": f"Bearer {os.environ['PHOTON_API_TOKEN']}"})
result = photon.projects.agent_profile.update(
    UpdateAgentProfileInput.model_validate({
        "path": {
            "projectId": "projectId",
        },
        "headers": {
            "Idempotency-Key": "idempotencyKey",
        },
        "body": {},
    })
)
```

```rust Rust
use photon_ai_api::{Credential, PhotonClientBuilder, SecretString};

let token = std::env::var("PHOTON_API_TOKEN")?;
let client = PhotonClientBuilder::new()
    .credential("accountServiceKey", Credential::Bearer(SecretString::from(token)))
    .build()?;
let result = client
    .update_agent_profile(
        "idempotencyKey".to_owned(),
        "projectId".to_owned(),
        &serde_json::from_value(serde_json::json!({}))?,
    )
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

</RequestExample>

