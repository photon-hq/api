result = photon.projects.platforms.batch_update_voice_line_profile_assignments(
    BatchUpdateVoiceLineProfileAssignmentsInput.model_validate({
        "path": {
            "id": "id",
        },
        "body": {
            "updates": [
                {
                    "expectedVersion": 1,
                    "profileId": "profileId",
                    "resourceId": "resourceId",
                },
            ],
        },
