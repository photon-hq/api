```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon({
  headers: { Authorization: `Bearer ${process.env.PHOTON_API_TOKEN}` },
});
const result = await photon.projects.platforms.batchUpdateVoiceLineProfileAssignments({
  path: {
    id: "id",
  },
  body: {
    updates: [
      {
        expectedVersion: 1,
        profileId: "profileId",
        resourceId: "resourceId",
      },
    ],
  },
});
```

