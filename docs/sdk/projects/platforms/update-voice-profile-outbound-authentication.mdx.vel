<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon({
  headers: { Authorization: `Bearer ${process.env.PHOTON_API_TOKEN}` },
});
const result = await photon.projects.platforms.updateVoiceProfileOutboundAuthentication({
  path: {
    id: "id",
    profileId: "profileId",
  },
  body: {
    authentication: {
      algorithm: "sha-256",
    },
    expectedVersion: 1,
  },
});
```

```python Python
import os

from photon_api import Photon
from photon_api.rpc_generated import UpdateVoiceProfileOutboundAuthenticationInput

photon = Photon(headers={"Authorization": f"Bearer {os.environ['PHOTON_API_TOKEN']}"})
result = photon.projects.platforms.update_voice_profile_outbound_authentication(
    UpdateVoiceProfileOutboundAuthenticationInput.model_validate({
        "path": {
            "id": "id",
            "profileId": "profileId",
        },
        "body": {
            "authentication": {
                "algorithm": "sha-256",
            },
            "expectedVersion": 1,
        },
    })
)
```

```rust Rust
use photon_ai_api::{Credential, PhotonClientBuilder, SecretString};

let token = std::env::var("PHOTON_API_TOKEN")?;
let client = PhotonClientBuilder::new()
    .credential("accountServiceKey", Credential::Bearer(SecretString::from(token)))
    .build()?;
let result = client
    .update_voice_profile_outbound_authentication(
        "id".to_owned(),
        "profileId".to_owned(),
        &serde_json::from_value(serde_json::json!({
            "authentication": {
                "algorithm": "sha-256",
            },
            "expectedVersion": 1,
        }))?,
    )
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

