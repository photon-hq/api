<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon({
  headers: { Authorization: `Bearer ${process.env.PHOTON_API_TOKEN}` },
});
const result = await photon.organizations.billing.cancelSubscription({
  path: {
    organizationId: "organizationId",
    projectId: "projectId",
  },
  body: {
    category: "category",
  },
});
```

```python Python
import os

from photon_api import Photon
from photon_api.rpc_generated import CancelSubscriptionInput

photon = Photon(headers={"Authorization": f"Bearer {os.environ['PHOTON_API_TOKEN']}"})
result = photon.organizations.billing.cancel_subscription(
    CancelSubscriptionInput.model_validate({
        "path": {
            "organizationId": "organizationId",
            "projectId": "projectId",
        },
        "body": {
            "category": "category",
        },
    })
)
```

```rust Rust
use photon_ai_api::{Credential, PhotonClientBuilder, SecretString};

let token = std::env::var("PHOTON_API_TOKEN")?;
let client = PhotonClientBuilder::new()
    .credential("accountServiceKey", Credential::Bearer(SecretString::from(token)))
    .build()?;
let result = client
    .cancel_subscription(
        "organizationId".to_owned(),
        "projectId".to_owned(),
        None,
        &serde_json::from_value(serde_json::json!({
            "category": "category",
        }))?,
    )
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

</RequestExample>

