<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon();
const result = await photon.system.redeemAppInstallationDelivery({
  body: {
    appId: "appId",
    clientAssertion: "clientAssertion",
    code: "code",
  },
});
```

```python Python
from photon_api import Photon
from photon_api.rpc_generated import RedeemAppInstallationDeliveryInput

photon = Photon()
result = photon.system.redeem_app_installation_delivery(
    RedeemAppInstallationDeliveryInput.model_validate({
        "body": {
            "appId": "appId",
            "clientAssertion": "clientAssertion",
            "code": "code",
        },
    })
)
```

```rust Rust
use photon_ai_api::PhotonClientBuilder;

let client = PhotonClientBuilder::new().build()?;
let result = client
    .redeem_app_installation_delivery(
        &serde_json::from_value(serde_json::json!({
            "appId": "appId",
            "clientAssertion": "clientAssertion",
            "code": "code",
        }))?,
    )
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

</RequestExample>

