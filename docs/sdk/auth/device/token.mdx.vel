```
</Tab>
</Tabs>

<RequestExample>
```typescript TypeScript
import { Photon } from "@photon-ai/api";

const photon = new Photon();
const result = await photon.auth.device.token({
  body: {
    device_code: "device_code",
    grant_type: "urn:ietf:params:oauth:grant-type:device_code",
  },
});
```

```python Python
from photon_api import Photon
from photon_api.rpc_generated import DeviceTokenInput

photon = Photon()
result = photon.auth.device.token(
    DeviceTokenInput.model_validate({
        "body": {
            "device_code": "device_code",
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        },
    })
)
```

```rust Rust
use photon_ai_api::PhotonClientBuilder;

let client = PhotonClientBuilder::new().build()?;
let result = client
    .device_token(
        &serde_json::from_value(serde_json::json!({
            "device_code": "device_code",
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        }))?,
    )
    .await
    .map_err(|error| format!("{error:?}"))?
    .into_inner();
```

</RequestExample>

