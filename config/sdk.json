{
  "environment": "production",
  "schemaPath": "openapi/openapi.json",
  "defaultBaseUrl": "https://api.photon.codes",
  "authEndpoints": {
    "oauth2": {
      "flows": {
        "authorizationCode": {
          "authorizationUrl": "https://auth.photon.codes/oauth2/authorize",
          "tokenUrl": "https://auth.photon.codes/oauth2/token"
        }
      }
    }
  },
  "namingWaiver": {
    "reason": "Type names for unnamed schemas are generated and change in 0.2.0, when the production contract names them.",
    "until": "0.2.0"
  }
}
