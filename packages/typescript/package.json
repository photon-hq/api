{
  "name": "@photon-ai/api",
  "version": "0.3.0",
  "description": "Generated Photon API RPC client for Node.js and browsers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build && node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "zod": "^4.5.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/api.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/photon-hq/api/tree/main/packages/typescript#readme",
  "bugs": {
    "url": "https://github.com/photon-hq/api/issues"
  }
}
